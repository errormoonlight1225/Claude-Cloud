#!/bin/sh
# Load Intel GPU drivers now that /lib/firmware is available. Each driver only binds to the
# platforms it supports (new Arc/Xe parts -> xe; older iGPUs -> i915). Failures are non-fatal:
# the EFI framebuffer (simpledrm) stays as a fallback console.
case "$1" in
  start)
    modprobe i915 2>/dev/null
    modprobe xe 2>/dev/null
    echo "macboot: GPU drivers: $(grep -E '^(i915|xe) ' /proc/modules | cut -d' ' -f1 | tr '\n' ' ')"
    ;;
esac
