#!/bin/sh
# Start the macOS guest under QEMU/KVM, fullscreen on the host KMS/DRM display.
. /etc/macboot.conf
[ -f /data/macboot.conf ] && . /data/macboot.conf
D=/data

die() { echo "macboot-launch: $*" >&2; exit 1; }
mountpoint -q "$D" || die "/data is not mounted (no MACDATA partition?)"
[ -c /dev/kvm ] || die "/dev/kvm missing: enable VT-x/AMD-V (and VT-d off if unstable) in firmware"
[ -f "$D/$OPENCORE_IMG" ] || die "missing $D/$OPENCORE_IMG (run scripts/prepare-data.sh on the build machine)"
[ -f "$D/$OVMF_CODE" ]    || die "missing $D/$OVMF_CODE"

# macOS panics on unhandled MSRs.
echo 1 > /sys/module/kvm/parameters/ignore_msrs
echo 0 > /sys/module/kvm/parameters/report_ignored_msrs 2>/dev/null

# vCPU count: macOS wants a power of two.
n=$(grep -c ^processor /proc/cpuinfo)
[ "$GUEST_CPUS" = auto ] && GUEST_CPUS=$n
p=1; while [ $((p*2)) -le "$GUEST_CPUS" ]; do p=$((p*2)); done; GUEST_CPUS=$p

[ -f "$D/OVMF_VARS.work.fd" ] || cp "$D/$OVMF_VARS" "$D/OVMF_VARS.work.fd" || die "missing $D/$OVMF_VARS"
[ -f "$D/$SYSTEM_DISK" ] || qemu-img create -f qcow2 -o lazy_refcounts=on,cluster_size=64k "$D/$SYSTEM_DISK" "$SYSTEM_DISK_SIZE" >/dev/null

MEMARGS="-m $GUEST_RAM"
if [ "$HUGEPAGES" = 1 ]; then
    gb=${GUEST_RAM%G}; echo $((gb*512+64)) > /proc/sys/vm/nr_hugepages
    mount -t hugetlbfs none /dev/hugepages 2>/dev/null
    MEMARGS="$MEMARGS -mem-path /dev/hugepages -mem-prealloc"
fi

INSTALL=""
if [ -f "$D/$INSTALL_IMG" ]; then
    INSTALL="-drive id=InstallMedia,if=none,file=$D/$INSTALL_IMG,format=raw -device ide-hd,bus=sata.3,drive=InstallMedia"
    echo "macboot: installer media attached ($INSTALL_IMG)"
fi

# Network: DHCP is handled by QEMU user-mode networking; the host needs no IP stack config.
export SDL_VIDEODRIVER=kmsdrm SDL_AUDIODRIVER=dummy

# shellcheck disable=SC2086
exec qemu-system-x86_64 \
    -enable-kvm -machine q35,accel=kvm $MEMARGS \
    -smp "$GUEST_CPUS",cores="$GUEST_CPUS",sockets=1 \
    -cpu "$CPU_MODEL" \
    -device isa-applesmc,osk="ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc" \
    -smbios type=2 \
    -global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off \
    -drive if=pflash,format=raw,readonly=on,file="$D/$OVMF_CODE" \
    -drive if=pflash,format=raw,file="$D/OVMF_VARS.work.fd" \
    -device ich9-ahci,id=sata \
    -drive id=OpenCoreBoot,if=none,snapshot=on,format=qcow2,file="$D/$OPENCORE_IMG" \
    -device ide-hd,bus=sata.2,drive=OpenCoreBoot \
    $INSTALL \
    -drive id=MacHDD,if=none,file="$D/$SYSTEM_DISK",format=qcow2,cache=writeback,discard=unmap \
    -device ide-hd,bus=sata.4,drive=MacHDD \
    -netdev user,id=net0 -device virtio-net-pci,netdev=net0,id=net0,mac=52:54:00:c9:18:27 \
    -device qemu-xhci,id=xhci -device usb-kbd,bus=xhci.0 -device usb-tablet,bus=xhci.0 \
    -device "$GUEST_GPU" \
    -display sdl,gl=off -full-screen \
    -vga none -no-user-config \
    $EXTRA_QEMU_ARGS
