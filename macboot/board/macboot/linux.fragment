# Kernel fragment: minimal host that runs one KVM guest.
CONFIG_HYPERVISOR_GUEST=n
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VHOST_NET=n
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_NET_9P=n

# Graphics for the *host* console (used by SDL2 KMSDRM to show the guest)
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_XE=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_SIMPLEDRM=y
# A text console on the host display is required so launcher errors are visible.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Storage / boot
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y

# Input
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_INPUT_EVDEV=y

# Memory saving
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_KSM=y
CONFIG_ZSWAP=n
CONFIG_SOUND=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_NFS_FS=n
CONFIG_DEBUG_INFO=n
CONFIG_PROFILING=n
